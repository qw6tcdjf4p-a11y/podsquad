{
  "name": "podsquad-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "test": "jest --runInBand --testTimeout=10000",
    "smoke:reply": "node scripts/smoke-reply.js",
    "smoke:root": "node scripts/smoke-root.js"
    ,"test:e2e": "playwright test",
    "test:e2e:ci": "npm run dev & echo $! > .pid.dev && sleep 3 && playwright test || true && kill $(cat .pid.dev) || true"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.77.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "typescript": "^5.5.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "@types/jest": "^29.5.4",
    "@playwright/test": "^1.38.0"
  }
}
